name: "quick-fix"
description: "Diagnose a defect, halt, then apply a minimal fix and verify"
agents:
phases:
  - id: diagnose
    kind: agent
    agent: griller
    prompt: "Diagnose {{prompt}}. Trace the root cause and name the smallest fix."
    halt: true
  - id: fix
    kind: agent
    agent: builder
    prompt: "Implement this diagnosis: {{diagnose}}"
  - id: verify
    kind: code
    command: "npm run test:adw"
    gates: [always_pass]
