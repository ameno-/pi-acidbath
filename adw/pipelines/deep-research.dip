name: "deep-research"
description: "Plan research questions, gather findings, then halt for human review"
agents:
phases:
  - id: plan
    kind: agent
    agent: researcher
    prompt: "Plan research questions for: {{prompt}}"
    halt: true
  - id: research
    kind: agent
    agent: researcher
    prompt: "Research these questions: {{plan}}"
  - id: report
    kind: halt
    prompt: "Review research: {{research}}"
